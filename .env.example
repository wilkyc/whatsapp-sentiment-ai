# Copy to .env (gitignored) for local runs, or add each value as a GitHub Actions secret.
# All values below are placeholders.

# --- Source DB: WhatsApp message store (PostgreSQL) ---
DB_HOST=your-source-db-host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- Target DB: Supabase (Session pooler) ---
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=your_supabase_password

# --- LLM (Poe API, OpenAI-compatible) ---
POE_API_KEY=your_poe_api_key

# --- Google Sheets (service account must have access) ---
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
KEYWORDS_SHEET_URL=https://docs.google.com/spreadsheets/d/<KEYWORDS_SHEET_ID>/edit
GROUPINFO_SHEET_URL=https://docs.google.com/spreadsheets/d/<GROUPINFO_SHEET_ID>/edit
# Optional: when set, ALL output goes to this single test sheet instead of production sheets
TEST_TARGET_SHEET_URL=

# --- Internal phone list (optional) ---
# Either inline JSON (recommended for GitHub Secrets) ...
INTERNAL_PHONES_JSON=
# ... or a local gitignored file (see internal_phones.example.json)
INTERNAL_PHONES_FILE=internal_phones.json

# --- Optional: rerun a specific date (yymmdd). Empty = yesterday (HKT) ---
MANUAL_DATE=
